# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
# Use the publishable key for new Supabase projects. The legacy anon key
# remains supported by the application during migration.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only secret used by authenticated admin API routes. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Production Site URL (Set to your live deployed domain, e.g., https://myclientwork.com)
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

