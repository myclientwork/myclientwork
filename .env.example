# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Production Site URL (Set to your live deployed domain, e.g., https://myclientwork.online)
NEXT_PUBLIC_SITE_URL=https://myclientwork.online

# Resend API Configuration
RESEND_API_KEY=
RESEND_FROM=

# SMTP Email Fallback Configuration (Nodemailer)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=
